{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Autocurl demo: Go",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/go-http-client",
      "env": {
        "AUTOCURL_DEMO_URL": "https://example.com/"
      }
    },
    {
      "name": "Autocurl demo: Go (restart required)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/go-http-client",
      "args": ["-repeat", "10", "-delay", "2s"],
      "env": {
        "AUTOCURL_DEMO_URL": "https://example.com/"
      }
    },
    {
      "name": "Autocurl demo: Go custom client (ignores env proxy)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/go-custom-http-client",
      "args": ["-proxy-mode", "ignore-env"],
      "env": {
        "AUTOCURL_DEMO_URL": "https://example.com/"
      }
    },
    {
      "name": "Autocurl demo: Go custom client (explicit proxy)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/go-custom-http-client",
      "args": ["-proxy-mode", "explicit-env-proxy"],
      "env": {
        "AUTOCURL_DEMO_URL": "https://example.com/"
      }
    },
    {
      "name": "Autocurl demo: Python",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/python-client/client.py",
      "console": "integratedTerminal",
      "env": {
        "AUTOCURL_DEMO_URL": "https://example.com/"
      }
    },
    {
      "name": "Autocurl demo: Java",
      "type": "java",
      "request": "launch",
      "mainClass": "AutocurlExample",
      "cwd": "${workspaceFolder}/examples/java-client",
      "env": {
        "AUTOCURL_DEMO_URL": "https://example.com/"
      }
    },
    {
      "name": "Autocurl demo: Node.js",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/Users/huanglingbo3/.nvm/versions/node/v22.16.0/bin/node",
      "program": "${workspaceFolder}/examples/node-client/client.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "AUTOCURL_DEMO_URL": "https://example.com/"
      }
    }
  ]
}
