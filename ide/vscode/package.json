{
  "name": "autocurl",
  "displayName": "Autocurl",
  "description": "Capture outbound requests from IDE debug sessions and copy complete replayable cURLs.",
  "version": "0.3.1",
  "publisher": "lingbo-huang",
  "license": "MIT",
  "pricing": "Free",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#24243A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lingbo-Huang/autocurl.git"
  },
  "homepage": "https://github.com/Lingbo-Huang/autocurl#readme",
  "bugs": {
    "url": "https://github.com/Lingbo-Huang/autocurl/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "curl",
    "http",
    "debug",
    "grpc",
    "websocket",
    "proxy"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:autocurl.requests",
    "onCommand:autocurl.start",
    "onCommand:autocurl.stop",
    "onCommand:autocurl.pause",
    "onCommand:autocurl.resume",
    "onCommand:autocurl.copyLast",
    "onCommand:autocurl.generateFromRequestJson",
    "onCommand:autocurl.runDiagnostics",
    "onDebug"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autocurl.start",
        "title": "Autocurl: Start Capture"
      },
      {
        "command": "autocurl.stop",
        "title": "Autocurl: Stop Session"
      },
      {
        "command": "autocurl.pause",
        "title": "Autocurl: Pause Recording"
      },
      {
        "command": "autocurl.resume",
        "title": "Autocurl: Resume Recording"
      },
      {
        "command": "autocurl.copyLast",
        "title": "Autocurl: Copy Last cURL"
      },
      {
        "command": "autocurl.copyRequest",
        "title": "Autocurl: Copy cURL"
      },
      {
        "command": "autocurl.showRequest",
        "title": "Autocurl: Show cURL"
      },
      {
        "command": "autocurl.clear",
        "title": "Autocurl: Clear Requests"
      },
      {
        "command": "autocurl.generateFromRequestJson",
        "title": "Autocurl: Generate cURL from Request JSON"
      },
      {
        "command": "autocurl.openQuickStart",
        "title": "Autocurl: Quick Start / 使用说明"
      },
      {
        "command": "autocurl.runDiagnostics",
        "title": "Autocurl: Run Environment Check"
      },
      {
        "command": "autocurl.downloadBinary",
        "title": "Autocurl: Download/Update Engine"
      }
    ],
    "configuration": {
      "title": "Autocurl",
      "properties": {
        "autocurl.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the autocurl executable. Empty uses the managed download or PATH."
        },
        "autocurl.autoDownload": {
          "type": "boolean",
          "default": true,
          "description": "Download the matching autocurl release from GitHub when no compatible executable is installed."
        },
        "autocurl.autoStartOnDebug": {
          "type": "boolean",
          "default": true,
          "description": "Start capture automatically and inject its process-scoped environment into debug launches."
        },
        "autocurl.injectDebugEnvironment": {
          "type": "boolean",
          "default": true,
          "description": "Merge capture proxy and temporary CA variables into IDE debug configurations."
        },
        "autocurl.captureMode": {
          "type": "string",
          "default": "safe",
          "enum": [
            "safe",
            "strict"
          ],
          "enumDescriptions": [
            "Keep mTLS, certificate-pinned, and otherwise incompatible TLS connections end-to-end when detected.",
            "Force TLS interception and report failures without automatic fallback."
          ],
          "description": "Safe prioritizes application compatibility; strict prioritizes complete capture."
        },
        "autocurl.match": {
          "type": "string",
          "default": "",
          "description": "Only show requests whose URL contains this text."
        },
        "autocurl.method": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ],
          "description": "Only show requests with this HTTP method."
        },
        "autocurl.replayHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Headers added only to generated cURLs, for example: x-debug-info: true."
        },
        "autocurl.liveHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Headers injected into live requests. Use with care."
        },
        "autocurl.bypassTargets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Hosts, IPs, domain suffixes, or CIDRs excluded from capture for mTLS and direct infrastructure calls."
        },
        "autocurl.maxBodyBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 1,
          "description": "Maximum request-body bytes retained for cURL generation."
        },
        "autocurl.startupDiagnosticSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Seconds to wait before checking optional listen ports and reporting that no proxy traffic was observed."
        },
        "autocurl.expectedListenPorts": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 65535
          },
          "default": [],
          "description": "Optional localhost ports the service should open, used only for startup diagnostics."
        },
        "autocurl.showSecrets": {
          "type": "boolean",
          "default": false,
          "description": "Include credentials and sensitive fields in output. Unsafe for shared logs."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "autocurl.requests",
          "name": "Autocurl Requests"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "autocurl.requests",
        "contents": "Capture outbound requests from your next debug launch.\n[Quick Start / 使用说明](command:autocurl.openQuickStart)\n[Start Capture](command:autocurl.start)\n[Run Environment Check](command:autocurl.runDiagnostics)\n[Open Settings](command:workbench.action.openSettings?%5B%22%40ext%3Alingbo-huang.autocurl%22%5D)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autocurl.start",
          "when": "view == autocurl.requests",
          "group": "navigation@1"
        },
        {
          "command": "autocurl.pause",
          "when": "view == autocurl.requests && autocurl.running && autocurl.recording",
          "group": "navigation@2"
        },
        {
          "command": "autocurl.resume",
          "when": "view == autocurl.requests && autocurl.running && !autocurl.recording",
          "group": "navigation@3"
        },
        {
          "command": "autocurl.stop",
          "when": "view == autocurl.requests && autocurl.running",
          "group": "navigation@4"
        },
        {
          "command": "autocurl.clear",
          "when": "view == autocurl.requests",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "autocurl.copyRequest",
          "when": "view == autocurl.requests && viewItem == autocurl.request",
          "group": "inline"
        },
        {
          "command": "autocurl.showRequest",
          "when": "view == autocurl.requests && viewItem == autocurl.request",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "autocurl.copyLast",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "npm run clean && npm run typecheck && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "ovsx": "^1.0.2",
    "typescript": "^5.8.0"
  }
}
